APP_ENV=development

SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: override team public OAuth client IDs (defaults are in ewastehub/oauth_public_defaults.py)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=

# GitHub OAuth only: client secret is required for /api/auth/github/* (never commit the real value)
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:5050/api/auth/github/callback
FRONTEND_URL=http://127.0.0.1:5173

# Password reset email delivery. Use an SMTP account/app password from your
# email provider. Without these values, development logs the reset link instead
# of sending a real email. Production requires SMTP to be configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=eWaste Hub
MAIL_SUPPRESS_SEND=false
PASSWORD_RESET_EMAIL_SUBJECT=Reset your eWaste Hub password

# Optional payment provider credentials. Without these, the app uses local
# stub checkout URLs suitable for demos and backend tests.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# In production, set APP_ENV=production and provide real SECRET_KEY/JWT_SECRET_KEY values.
