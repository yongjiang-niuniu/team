VITE_API_BASE_URL=http://127.0.0.1:5050
# Use VITE_API_BASE_URL=same-origin when the frontend dev server proxies /api,
# for example in the ngrok public demo launcher.

# Optional: overrides repo defaults in src/config/oauthPublicDefaults.ts (fresh clone works without this file)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
